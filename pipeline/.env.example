# ============================================================
# Provider selection
# ============================================================
# Supported values: openai, qwen, gemini, vertex
MODEL_PROVIDER=openai

# Models used by the four stages.
# Use model names supported by the selected provider.
PARSER_MODEL=
STYLE_MODEL=
CRITIC_MODEL=
LAYOUT_MODEL=

# ============================================================
# Provider-specific credentials and endpoints
# ============================================================

# openai
# Uses the official OpenAI API when OPENAI_BASE_URL is empty.
# OPENAI_BASE_URL can point to an OpenAI-compatible service.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# qwen
# Qwen is accessed through the OpenAI-compatible client above.
# Set MODEL_PROVIDER=qwen and provide OPENAI_API_KEY and/or
# OPENAI_BASE_URL. Qwen-specific thinking control is optional.
QWEN_ENABLE_THINKING=false

# gemini
# Required when MODEL_PROVIDER=gemini.
GOOGLE_API_KEY=

# vertex
# Required when MODEL_PROVIDER=vertex.
# Authentication can use Application Default Credentials, or the path in
# GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# Shared generation settings
# ============================================================
MODEL_TEMPERATURE=0.1
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_TIMEOUT_SECONDS=600

# Optional pricing metadata for metrics/cost reporting.
# Must be a JSON object. Leave as {} if cost reporting is not needed.
MODEL_PRICING_JSON={}

# ============================================================
# Local tools and optional model access
# ============================================================

# Draw.io executable used to render XML to PNG/JPG.
# Windows example:
# DRAWIO_BIN=C:\Program Files\draw.io\draw.io.exe
DRAWIO_BIN=

# Hugging Face token used indirectly by SAM3 when its checkpoint requires
# authenticated access. Leave empty if authentication is already configured
# elsewhere or the checkpoint is available locally.
HF_TOKEN=
